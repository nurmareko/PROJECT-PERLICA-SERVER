# --- Application Server ---
PORT=3001               # Port: 1-65535 (local listening port)
NODE_ENV="development" # Enum: development | production | test

# --- Primary Database ---
# Type: MySQL connection URI
DATABASE_URL="mysql://perlica_dev:replace_with_local_db_password@localhost:3306/project_perlica_dev"

# --- Database Seeding ---
ENABLE_DEV_SEEDING=false # Boolean
DEV_SEED_PASSWORD=       # String: 12-72 UTF-8 bytes (required if seeding enabled)

# --- Outbound Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587            # Port: 1-65535 (587 for STARTTLS)

# Primary/Transactional Sender
AUTH_MAILER_EMAIL=
AUTH_MAILER_APP_PASSWORD=

# Automated Reports Sender
REPORT_MAILER_EMAIL=
REPORT_MAILER_APP_PASSWORD=

# --- Google Maps API ---
GOOGLE_MAPS_API_KEY= # Alphanumeric API key (restrict in Cloud Console)

# --- Asset Fallbacks ---
# Valid URL or blank (blank resolves to null)
FALLBACK_CUSTOMER_AVATAR_URL=
FALLBACK_DRIVER_AVATAR_URL=
