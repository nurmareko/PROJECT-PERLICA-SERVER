{
  "name": "project-perlica-server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Project Perlica",
  "author": "D. Nurmareko",
  "contributors": [
    {
      "name": "Alhymni Russy"
    }
  ],
  "license": "ISC",
  "main": "src/main.js",
  "engines": {
    "node": "^24.11.0",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "generate": "prisma generate",
    "seed": "prisma db seed",

    "check": "npm run lint && prisma validate && npm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --globals --no-file-parallelism --exclude test/integration/**",
    "test:integration": "vitest run --config vitest.integration.config.js",

    "check:google-maps": "node test/check-google-maps.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "joi": "^18.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.13.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
